# ---------------------------------------------------------------------------
# Fantasy Football Intelligence Engine — environment template
#
# Copy to .env and fill in.  The real .env is gitignored and must never be
# committed: espn_s2 is a live session token for your ESPN account.
#
#     cp .env.example .env
#     python auth_bridge.py      # fills SWID and ESPN_S2 automatically
# ---------------------------------------------------------------------------

# --- League identity -------------------------------------------------------

# From your league URL:
#   https://fantasy.espn.com/football/league?leagueId=123456789
LEAGUE_ID=

# The fantasy season year, e.g. 2026.
SEASON=2026

# Your own team id within the league, 1..12. Optional — the war-room assistant
# infers it from the draft board once you have made a pick. Setting it means
# roster analysis works from pick one.
TEAM_ID=

# --- Session credentials ---------------------------------------------------
#
# Populated by `python auth_bridge.py`. Do not hand-edit unless you know why.
#
# SWID is your ESPN account's global id, a braced UUID:
#     {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
#
# ESPN_S2 is a long URL-encoded session token, typically 300+ characters.
# It expires on password change and rotates roughly annually. A 401 from any
# script in this repo means re-run auth_bridge.py — not that the code broke.

SWID=
ESPN_S2=
